# Optional. Without this the storage-risk feature uses a deterministic mock
# forecast, which is what the demo runs on by default.
OWM_API_KEY=

# Flask session key. Any random string.
SECRET_KEY=change-me-in-production

# Slots further out than this many days are assessed for storage risk.
STORAGE_RISK_LEAD_DAYS=5

# Optional. Book by speaking asks Gemini to understand the sentence first, and
# falls back to the offline word-list parser without it. Key from Google AI Studio.
GEMINI_API_KEY=
# Optional. Models to try, fastest first, comma separated.
# GEMINI_MODEL=gemini-flash-lite-latest,gemini-3.5-flash-lite
